PORT=5000
FRONTEND_URL=http://localhost:5173

# Optional. Public repository ingestion works without it; setting a GitHub
# personal access token only raises the anonymous rate limit.
# GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# GitHub sign-in (Phase 3) - required only for PRIVATE repositories
# ---------------------------------------------------------------------------
# Public repository analysis works with none of this set. Leave it unset and
# the "Connect GitHub" button reports that sign-in is unavailable; everything
# else keeps working.
#
# To enable sign-in, register a GitHub App at
#   https://github.com/settings/apps/new
# with:
#   Callback URL .................. http://localhost:5000/api/auth/github/callback
#   Request user authorization (OAuth) during installation ... enabled
#   Webhook ....................... disabled
#   Repository permissions ........ Contents: Read-only, Metadata: Read-only
#
# Then copy the app's Client ID, generate a client secret, and set both below.
# The app's private key and App ID are NOT needed: DriftWatch only uses the
# user authorization flow, never server-to-server installation tokens.
#
# Never commit real values. This file holds placeholders only; put the real
# ones in backend/.env, which is git-ignored.
# GITHUB_APP_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
# GITHUB_APP_CLIENT_SECRET=replace-with-your-client-secret
#
# Optional. Defaults to http://localhost:<PORT>/api/auth/github/callback, which
# is what the backend actually serves. Set it explicitly for any deployment
# that is not local, and make it match the GitHub App's Callback URL exactly.
# GITHUB_APP_CALLBACK_URL=https://your-host/api/auth/github/callback

# Set to true when the backend is served over HTTPS so the session cookie
# carries the Secure attribute. Leave unset for local http://localhost.
# SESSION_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Phase 4 — dependency analysis limits (all optional)
# ---------------------------------------------------------------------------
# Reaching a limit produces a partial analysis flagged as truncated in the
# response, never a failure. Defaults shown.
#
# Source files parsed per repository.
# DRIFTWATCH_MAX_SOURCE_FILES=600
#
# Largest single file read from the repository archive, in bytes (512 KB).
# DRIFTWATCH_MAX_FILE_SIZE_BYTES=524288
#
# Total source held in memory for one analysis, in bytes (24 MB).
# DRIFTWATCH_MAX_TOTAL_SOURCE_BYTES=25165824
#
# Repositories larger than this are refused before the archive is downloaded,
# in kilobytes as GitHub reports repository size (250 MB).
# DRIFTWATCH_MAX_REPO_SIZE_KB=256000

# ---------------------------------------------------------------------------
# Phase 5 - workflow analysis limits (all optional)
# ---------------------------------------------------------------------------
# Reaching a limit produces a partial result flagged as truncated, never a
# failure. Defaults shown.
#
# Workflow files parsed per repository.
# DRIFTWATCH_MAX_WORKFLOWS=50
#
# Jobs kept per workflow.
# DRIFTWATCH_MAX_JOBS_PER_WORKFLOW=100
#
# Steps kept per job.
# DRIFTWATCH_MAX_STEPS_PER_JOB=100
