PORT=5000
FRONTEND_URL=http://localhost:5173

# Optional. Public repository ingestion works without it; setting a GitHub
# personal access token only raises the anonymous rate limit.
# GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# GitHub App (Phase 3) — required only to sign in and read private repositories
# ---------------------------------------------------------------------------
# Register a GitHub App (Settings > Developer settings > GitHub Apps) and set:
#
#   Callback URL: http://localhost:5000/api/auth/github/callback
#   Repository permissions: Contents = Read-only, Metadata = Read-only
#   "Request user authorization (OAuth) during installation": enabled
#
# Only the client id/secret and callback are needed. The app's private key and
# App ID are used exclusively for server-to-server installation tokens, which
# DriftWatch does not mint — so the private key never has to exist here.
#
# Leave these unset to run anonymously: public repository analysis still works
# and the sign-in route reports that it is unavailable.
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Set to true when the backend is served over HTTPS so the session cookie
# carries the Secure attribute. Leave unset for local http://localhost.
# SESSION_COOKIE_SECURE=false
